BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./gitofy.db
REDIS_URL=
ENCRYPTION_KEY=
STORAGE_BACKEND=local
STORAGE_PATH=./data
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
LOG_LEVEL=INFO
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
ADMIN_IDS=
SESSION_TTL_SECONDS=900
LOCK_TTL_SECONDS=300
CLEANUP_MINUTES=30
POLL_INITIAL_SECONDS=10
POLL_MAX_SECONDS=60
ARTIFACT_SIGNING_SECRET=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_PROVIDER=auto
AI_AUTOFIX_ENABLED=true
MAX_ZIP_BYTES=524288000
MAX_EXTRACTED_BYTES=2147483648
MAX_FILES=20000

# ZIP uploads: Gitofy accepts up to 50 MiB. Telegram's official Bot API
# currently allows only 20 MiB downloads; use a Local Bot API Server for >20 MiB.
MAX_ZIP_BYTES=52428800
# For normal Telegram Cloud API leave these commented.
# TELEGRAM_API_BASE_URL=http://127.0.0.1:8081
# TELEGRAM_FILE_BASE_URL=http://127.0.0.1:8081/file
# /update performs a full working-tree replacement: files missing from the ZIP are removed while Git history is preserved.
GITOFY_GIT_ENGINE=auto

# Gitofy AI orchestration
AI_PROVIDER=auto
AI_AUTOFIX_ENABLED=true
AI_HEAD_MODEL=gemini-3.7-flash
AI_FIX_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemma-4-26b-a4b-it,qwen/qwen3.8-flash,meta/muse-glimmer-30b,nvidia/nemotron-3.5-lightning,openai/gpt-4o-mini,cohere/north-mini-code:free,minimax/minimax-m3:free,poolside/laguna-s-2.1,poolside/laguna-xs-2.1,inclusionai/ling-3.0-flash-fin:free

# AI provider keys can also be configured securely from Telegram Settings > AI Providers.
# If ADMIN_IDS is set, only those Telegram user IDs can change provider keys.
